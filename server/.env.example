# SERVER ONLY. Never include database/Redis credentials in an APK.
PORT=8080
DATABASE_URL=postgres://tfasset:CHANGE_ME@localhost:5432/tfasset_market
REDIS_URL=redis://localhost:6379
MARKET_TRACKED_SYMBOLS=0050,0056,00878,00919,00929,00713
TZ=Asia/Taipei
CORS_ORIGIN=
MARKET_WATCH_ENABLED=true
# Optional market providers. Secrets stay on the server and MUST NOT be bundled into the APK.
FUGLE_API_KEY=
# Fugle primary transport stays server-side over TLS/WSS; never place the key in the APK.
FUGLE_WS_URL=wss://api.fugle.tw/marketdata/v1.0/stock/streaming
# REST is bootstrap/reconnect only, not a 1-second polling loop.
FUGLE_REST_CACHE_MS=15000
# Read-only normalized quote bridge. Shioaji login credentials remain inside that bridge.
SHIOAJI_BRIDGE_URL=
# Optional approved/licensed NAV endpoint. When empty, isolated TWSE MIS ETF iNAV is used as fallback.
ETF_NAV_FEED_URL=
# TF Asset live cadence supports 1 second minimum; per-source circuit breakers prevent retry storms.
MARKET_POLL_SECONDS=1
MARKET_DAILY_REFRESH_MINUTES=5
